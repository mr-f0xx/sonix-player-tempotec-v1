# Copy to the root of the microSD card as streaming-keys.ini (never commit it).
#
# Note on [tidal]: Sonix uses Tidal's v1 OAuth2 Device Authorization flow
# (link.tidal.com) and unencrypted v1 FLAC/AAC streams, matching the stock V1
# firmware. Self-serve apps created on developer.tidal.com are OpenAPI v2 keys
# that lack the Limited Input Device grant and fail with:
#   "Client is not a Limited Input Device client."
# Run `python3 sonix-player/tools/extract_streamkeys.py <unpacked-rootfs>` to
# extract the working [qobuz] and [tidal] pairs from your stock V1 firmware.

[qobuz]
app_id = 
app_secret = 

[tidal]
client_id = 
client_secret = 
# Optional override; when omitted, Sonix tries "r_usr w_usr" and automatically
# falls back to "r_usr" for read-only device keys such as the stock V1 pair.
# scope = r_usr w_usr

# Optional: Podcasts works with no keys at all, from Apple's public directory,
# which needs no signup. Fill these in only to use Podcast Index instead -- and
# then also set, in device_config.ini:
#   [podcast]
#   api_base = https://api.podcastindex.org/api/1.0
# Podcast Index's terms do not allow registrations from a free email service,
# so the pair has to be requested from an address on a domain you control.
[podcast]
api_key =
api_secret = 

[lastfm]
api_key =
api_secret = 

# Optional: YouTube Music works without this -- search and playback are public.
# The key is the InnerTube key the music.youtube.com page hands every visitor
# (Google's, not a credential of anybody's). A build may carry it via
# `make YTMUSIC_API_KEY=...` or a .ytmusic-key file; the card only fills a gap,
# so put it here when the image was built without one.
[ytmusic]
api_key =

# Optional: SoundCloud works with no keys at all (client_id is discovered
# automatically). You can configure your SoundCloud username and/or oauth_token
# directly in Streaming -> SoundCloud -> Account settings, or place them here:
[soundcloud]
# username = your-profile-handle
# oauth_token = 
# client_id = 
